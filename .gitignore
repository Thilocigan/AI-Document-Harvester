# ============================================================
# Root .gitignore - AI Driven PDF Crawler & Synthesizer
# ============================================================

# Virtual Environments
backend/venv/
venv/
.venv/
env/
ENV/
*.venv

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Dynamic Job Storage & Generated PDFs (Ignore runtime generated files)
backend/storage/*
!backend/storage/.gitkeep

# Node.js & Dependencies
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (Never commit secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.pem
*.key

# IDE & Editor Configuration
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating System Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
