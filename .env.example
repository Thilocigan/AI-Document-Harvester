# ============================================================
# Environment Configuration Template
# Copy this file to `.env` (or `backend/.env`) if you wish to configure API keys.
# Note: If no API keys are provided, the platform automatically uses the 
# built-in local heuristic NLP & TF-IDF synthesizer (100% offline capable).
# ============================================================

# OpenAI API Key (Optional - for GPT-4o synthesis)
OPENAI_API_KEY=

# Google Gemini API Key (Optional - for Gemini 2.5 Flash synthesis)
GEMINI_API_KEY=

# Backend Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=5173
